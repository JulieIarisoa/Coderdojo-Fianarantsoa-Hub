rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN"; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isAdmin() || (isOwner(userId) && changedOnly(["name", "email", "avatar", "bio", "skills", "workshopsCount", "projectsCount", "studentsCount", "memoriesCount", "encryptionPublicKey", "updatedAt"]));
      allow delete: if isAdmin();
    }

    match /campfirePosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && changedOnly(["reactions", "likesCount", "commentsCount"])) || (signedIn() && resource.data.authorId == request.auth.uid && changedOnly(["content", "category", "linkPreview"]));
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    match /memories/{memoryId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && changedOnly(["reactions", "likesCount", "commentsCount"])) || (signedIn() && resource.data.authorId == request.auth.uid && changedOnly(["title", "description", "imageUrl", "images", "cloudinaryId", "eventDate"]));
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    match /secretFriendCampaigns/{campaignId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /secretFriendAssignments/{assignmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.mentorId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.mentorId == request.auth.uid && changedOnly(["actionJournal", "completed"]));
      allow create, delete: if isAdmin();
    }


    function assignmentForMessage(message) {
      return get(/databases/$(database)/documents/secretFriendAssignments/$(message.assignmentId)).data;
    }

    match /secretFriendMessages/{messageId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid));
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId != request.auth.uid &&
        request.resource.data.read == false &&
        assignmentForMessage(request.resource.data).campaignId == request.resource.data.campaignId &&
        ((assignmentForMessage(request.resource.data).mentorId == request.auth.uid &&
          request.resource.data.recipientId == assignmentForMessage(request.resource.data).secretFriendId) ||
         (assignmentForMessage(request.resource.data).secretFriendId == request.auth.uid &&
          request.resource.data.recipientId == assignmentForMessage(request.resource.data).mentorId));
      allow update: if isAdmin() ||
        (signedIn() && resource.data.recipientId == request.auth.uid && changedOnly(["read"]));
      allow delete: if isAdmin();
    }

    match /guessWhoGames/{gameId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /votes/{voteId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /dailyQuestions/{questionId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /badges/{badgeId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /milestones/{milestoneId} { allow read: if signedIn(); allow write: if isAdmin(); }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.userId != request.auth.uid &&
        request.resource.data.read == false &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.type in ["badge", "comment", "reaction", "memory", "secret-friend", "message"];
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid && changedOnly(["read"]));
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() &&
        (!exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
         request.auth.uid in resource.data.participants);
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participants &&
        changedOnly(["lastMessage", "unreadCounts", "typingUsers", "updatedAt", "participantProfiles"]);
      allow delete: if isAdmin();
    }

    match /directMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.fromId == request.auth.uid &&
        request.resource.data.toId != request.auth.uid &&
        request.resource.data.encryptionVersion == 1 &&
        request.resource.data.ciphertext is string &&
        request.resource.data.iv is string;
      allow update: if isAdmin() ||
        (signedIn() && resource.data.toId == request.auth.uid && changedOnly(["read"])) ||
        (signedIn() &&
          (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid) &&
          request.resource.data.conversationId is string &&
          changedOnly(["conversationId"]));
      allow delete: if isAdmin();
    }
  }
}
